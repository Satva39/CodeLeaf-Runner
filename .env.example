# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the SAME value in CodeLeaf backend as RUNNER_SERVICE_TOKEN.
CODELEAF_RUNNER_SERVICE_TOKEN=CHANGE_ME_BEFORE_DEPLOY
# Optional: previous token accepted during a controlled rotation window only.
CODELEAF_RUNNER_PREVIOUS_SERVICE_TOKEN=
# Separate internal credential used only between database-worker and Docker gateway.
RUNNER_DOCKER_GATEWAY_TOKEN=GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Internal Docker Compose addresses. Do not expose Redis or Piston publicly.
REDIS_URL=redis://redis:6379/0
PISTON_BASE_URL=http://piston:2000

# Queue and abuse controls.
RUNNER_MAX_QUEUE_DEPTH=250
RUNNER_MAX_ACTIVE_PER_USER=2
RUNNER_MAX_INTERACTIVE_SESSIONS_PER_USER=1
RUNNER_MAX_JOBS_PER_MINUTE=8
RUNNER_WORKER_CONCURRENCY=2
RUNNER_JOB_TTL_SECONDS=86400
RUNNER_REQUESTS_PER_MINUTE_PER_IP=3000
RUNNER_REQUEST_RATE_WINDOW_SECONDS=60
RUNNER_MAX_API_BODY_BYTES=2097152
# Uvicorn concurrency/backlog are set explicitly in Compose for API and Docker gateway.
RUNNER_PRODUCTION_MODE=false
# Leave empty for the private backend-to-backend websocket proxy. If an Origin is sent,
# list exact allowed origins separated by commas.
RUNNER_ALLOWED_WEBSOCKET_ORIGINS=
RUNNER_WEBSOCKET_CONNECTIONS_PER_MINUTE_PER_IP=600

# Piston limits (milliseconds / bytes). The compile allowance is higher for JVM builds; runtime limits stay short.
PISTON_COMPILE_TIMEOUT_MS=30000
PISTON_RUN_TIMEOUT_MS=3000
PISTON_COMPILE_CPU_TIME_MS=30000
PISTON_RUN_CPU_TIME_MS=3000
PISTON_COMPILE_MEMORY_LIMIT_BYTES=536870912
PISTON_RUN_MEMORY_LIMIT_BYTES=134217728
PISTON_OUTPUT_MAX_SIZE=65536
PISTON_MAX_CONCURRENT_JOBS=2

# HTTP client timeout includes compile + run time + a margin.
PISTON_HTTP_TIMEOUT_SECONDS=45
PISTON_CONNECT_TIMEOUT_SECONDS=3

# Piston image. Pin this to an immutable image digest before a public production launch.
PISTON_IMAGE=ghcr.io/engineer-man/piston:latest
REDIS_IMAGE=redis:7.4-alpine
PISTON_ADMIN_IMAGE=alpine/socat:latest
RUNNER_PYTHON_BASE_IMAGE=python:3.12-slim

# Interactive terminal sessions (stdin streaming, output streaming, process signals).
INTERACTIVE_INIT_TIMEOUT_SECONDS=5
INTERACTIVE_INPUT_IDLE_TIMEOUT_SECONDS=90
INTERACTIVE_MAX_SESSION_SECONDS=120
INTERACTIVE_SESSION_TTL_SECONDS=180
INTERACTIVE_MAX_MESSAGE_BYTES=32768
INTERACTIVE_MAX_INPUT_MESSAGE_BYTES=16384
INTERACTIVE_MAX_TOTAL_INPUT_BYTES=65536
INTERACTIVE_MAX_OUTPUT_BYTES=65536
INTERACTIVE_MAX_MESSAGES=256

# Phase 4 database execution. MySQL/PostgreSQL are created as disposable
# containers on an internal-only Docker network; they never use production DBs.
DATABASE_EXECUTION_ENABLED=true
RUNNER_DATABASE_MAX_ACTIVE_PER_USER=2
RUNNER_DATABASE_JOBS_PER_MINUTE=6
RUNNER_DATABASE_MAX_QUEUE_DEPTH=100
RUNNER_DATABASE_JOB_TTL_SECONDS=86400
RUNNER_DATABASE_WORKER_CONCURRENCY=2
RUNNER_DATABASE_MAX_QUERY_BYTES=65536
RUNNER_DATABASE_MAX_SETUP_BYTES=131072
RUNNER_DATABASE_MAX_ROWS=100
RUNNER_DATABASE_MAX_RESULT_BYTES=65536
RUNNER_DATABASE_QUERY_TIMEOUT_SECONDS=3
RUNNER_DATABASE_STARTUP_TIMEOUT_SECONDS=20
RUNNER_DATABASE_JOB_TIMEOUT_SECONDS=35
# Database worker accesses Docker only through the constrained docker-gateway service.
RUNNER_DATABASE_DOCKER_SOCKET=http://docker-gateway:2375
RUNNER_DATABASE_DOCKER_API_VERSION=1.45
RUNNER_DATABASE_WORKER_CONTAINER=codeleaf-runner-database-worker
RUNNER_DATABASE_POSTGRES_IMAGE=postgres:17.11-bookworm
RUNNER_DATABASE_MYSQL_IMAGE=mysql:8.4.13
